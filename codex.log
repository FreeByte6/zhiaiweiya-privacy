+      font-family: system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
+      font-size: 16px;
+      line-height: 1.9;
+      overflow-wrap: anywhere;
+    }
+    ::selection { background: #cbe9db; color: #163d31; }
+    a { color: var(--accent); text-underline-offset: 0.22em; }
