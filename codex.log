+    article { padding: 36px 40px 40px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); }
+    h1 { margin: 0 0 24px; font-size: clamp(25px, 5.5vw, 32px); line-height: 1.5; }
+    h1 span { display: block; }
+    .metadata { margin: 0 0 24px; color: var(--muted); font-size: 14px; }
+    .metadata div { display: flex; flex-wrap: wrap; gap: 0 0.5em; }
+    .metadata dt, .metadata dd { margin: 0; }
+    time { font-variant-numeric: tabular-nums; }
+    p { margin: 0 0 16px; }
+    p:last-child { margin-bottom: 0; }
+    .summary { margin: 24px 0; padding: 20px; border-radius: 12px; background: var(--summary); }
+    .contents { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); }
+    .contents h2 { margin: 0 0 8px; font-size: 17px; }
+    .contents ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; margin: 0; padding: 0; list-style: none; }
+    .contents a { display: flex; align-items: center; min-height: 44px; padding: 5px 0; }
+    section { margin-top: 40px; scroll-margin-top: 20px; }
+    section h2 { margin: 0 0 16px; font-size: 22px; line-height: 1.5; }
+    h3 { margin: 28px 0 12px; font-size: 18px; line-height: 1.6; }
