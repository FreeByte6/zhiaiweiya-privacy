def luminance(color):
    channels = [int(color[i:i+2], 16) / 255 for i in (1, 3, 5)]
    channels = [x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4 for x in channels]
    return sum(x * w for x, w in zip(channels, (.2126, .7152, .0722)))
for color in ('#203047', '#526177', '#226b54'):
    for background in ('#ffffff', '#f5f7f9', '#edf5f0'):
        a, b = sorted((luminance(color), luminance(background)))
        contrast = (b + .05) / (a + .05)
        assert contrast >= 4.5, (color, background, contrast)
print('Body, secondary text and links exceed WCAG AA 4.5:1 contrast on all page surfaces.')
