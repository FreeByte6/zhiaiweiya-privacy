    assert doc.get('lang') == 'zh-CN', name
    assert doc.xpath('//meta[@charset=\"utf-8\"]'), name
    assert doc.xpath('//meta[@name=\"viewport\"]'), name
    assert len(doc.xpath('//h1')) == 1, name
    assert len(doc.xpath('//style')) == 1, name
    assert not doc.xpath('//script | //link | //img | //iframe | //object | //embed | //form | //audio | //video | //source | //base'), name
    css = doc.xpath('//style')[0].text
    assert not re.search(r'@import|url\\s*\\(', css, re.I), name
    ids = doc.xpath('//@id')
    assert len(ids) == len(set(ids)), name
    for anchor in doc.xpath('//a[@href]'):
        link = urlsplit(anchor.get('href'))
        assert link.scheme in ('', 'mailto'), (name, link)
        if link.scheme == 'mailto':
            assert link.path == 'tolovelife@foxmail.com', (name, link.path)
        elif link.path:
            assert (root / unquote(link.path)).is_file(), (name, link.path)
        elif link.fragment:
            assert link.fragment in ids, (name, link.fragment)
    if name "'!= '"'index.html':
        headings = [''.join(h.itertext()) for h in doc.xpath('//section/h2')]
