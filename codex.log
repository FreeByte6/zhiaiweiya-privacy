        text_content = doc.text_content()
        for fact in ('localStorage', '不收集任何个人信息', '离线模拟', '无账号', '知艾薇亚', 'tolovelife@foxmail.com'):
            assert fact in text_content, (name, fact)
        assert len(doc.xpath('//table/tbody/tr')) == 5, name
    if name "'!= '"'TEMPLATE.html':
        assert '{{' not in raw and '待填写' not in raw, name
    print(f'{name}: valid structure, local links, inline CSS, no resource dependencies ({path.stat().st_size:,} bytes)')

