+    footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 24px; color: var(--muted); font-size: 14px; }
+    footer p { margin: 0; }
+    footer a { display: inline-flex; align-items: center; min-height: 44px; }
